{
  "name": "code-diagrammer",
  "displayName": "Code Diagrammer",
  "description": "See a PyTorch model as an expandable architecture diagram with tensor shapes, inside the editor.",
  "version": "0.4.0",
  "publisher": "code-diagrammer",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Visualization", "Machine Learning"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": ["codeDiagrammer.pythonPath"],
      "description": "Tracing shapes runs your model code and is disabled in untrusted workspaces."
    }
  },
  "contributes": {
    "commands": [
      { "command": "codeDiagrammer.open", "title": "Code Diagrammer: Open Architecture Diagram" },
      { "command": "codeDiagrammer.openProject", "title": "Code Diagrammer: Open Project Architecture" },
      { "command": "codeDiagrammer.traceShapes", "title": "Code Diagrammer: Trace Shapes" },
      { "command": "codeDiagrammer.selectEntry", "title": "Code Diagrammer: Select Entry Model" },
      { "command": "codeDiagrammer.chooseModel", "title": "Code Diagrammer: Choose Language Model" },
      { "command": "codeDiagrammer.scanProject", "title": "Code Diagrammer: Scan Project Models" },
      { "command": "codeDiagrammer.togglePaperView", "title": "Code Diagrammer: Toggle Stages View" },
      { "command": "codeDiagrammer.testModel", "title": "Code Diagrammer: Test Language Model" },
      { "command": "codeDiagrammer.setGeminiKey", "title": "Code Diagrammer: Set Gemini API Key" },
      { "command": "codeDiagrammer.clearGeminiKey", "title": "Code Diagrammer: Clear Gemini API Key" }
    ],
    "menus": {
      "editor/title": [
        { "command": "codeDiagrammer.open", "when": "resourceLangId == python", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "Code Diagrammer",
      "properties": {
        "codeDiagrammer.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter used to analyze models. Empty: use the Python extension's interpreter, or `python` on PATH. Tracing shapes needs Python 3.11+ with torch installed."
        },
        "codeDiagrammer.traceTimeoutSeconds": {
          "type": "number",
          "default": 60,
          "description": "Stop Trace Shapes after this many seconds."
        },
        "codeDiagrammer.llm.model": {
          "type": "string",
          "default": "",
          "description": "Id of the language model (a model offered by this IDE, or a Gemini model reached with your own API key) used for the project architecture, Scan Project Models, block roles and the Stages view. Empty: you are asked to choose. Use the command \"Code Diagrammer: Choose Language Model\" to pick from the available models."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "elkjs": "^0.9.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
